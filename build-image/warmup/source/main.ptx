<?xml version="1.0" encoding="UTF-8"?>

<pretext>
  <docinfo>
    <latex-image-preamble>
      \usepackage{tikz, pgfplots}
    </latex-image-preamble>
  </docinfo>

  <article xml:id="warmup">
    <title>Warmup</title>

    <frontmatter xml:id="frontmatter">
      <bibinfo>
        <date>Last Updated: <today/></date>
      </bibinfo>

      <titlepage>
        <titlepage-items/>
      </titlepage>
    </frontmatter>

    <section xml:id="sec-warmup">
      <title>Warmup Section</title>

      <p>
        Inline math <m>x^2 + y^2 = z^2</m> forces MathJax/static asset setup.
      </p>

      <figure>
        <caption>
          A latex-image forces the asset-generation (npm) pipeline.
        </caption>

        <image xml:id="fig-warmup">
          <latex-image>
            \begin{tikzpicture}
              \draw[thick] (0,0) -- (2,1) -- (1,2) -- cycle;
            \end{tikzpicture}
          </latex-image>
        </image>
      </figure>
      <!-- Interactive elements to set up puppeteer -->
      <p>
        Interactive elements to set up puppeteer.
      </p>

      <figure xmlns:pi="http://pretextbook.org/2020/pretext/internal">
        <caption>Right Triangle Paradox</caption>
        <interactive xml:id="geogebra-right-triangle" geogebra="KGn2d4Qd" width="70%" aspect="9:5" reset-icon="yes">
          <description>
            <p>
              An interactive puzzle.
              The puzzle shows two triangles placed on a square grid.
              On the left, there is a triangle decomposed into four pieces.
              On the right, there is a triangle with outlines corresponding to
              the sizes and shapes of the pieces in the left triangle.
              The pieces from the left triangle can be dragged to the right.
              However, the triangle on the right has one additional grid square
              containing a question mark.
            </p>
          </description>
        </interactive>
      </figure>
    </section>

    <section xml:id="sec-fitb">
      <title>FITB</title>

      <p>
        Here is an example of a fill-in-the-blank (FITB) question to ensure we
        have the node setup for that.
      </p>

      <exercise label="ex-demo-jscmp-primes" xmlns:pi="http://pretextbook.org/2020/pretext/internal">
        <title>Fill-In, Javascript test of numbers</title>

        <statement>
          <p>
            What is an example of a prime number less than 20?
            <fillin width="5" answer="13"/>
          </p>
        </statement>
        <evaluation>
          <evaluate>
            <test correct="yes">
              <jscmp>
                <!-- test if number is in a list -->
                [2, 3, 5, 7, 11, 13, 17, 19].includes(Number(ans))
              </jscmp>

              <feedback>
                <p>
                  Any number from the list <m>\{2, 3, 5, 7, 11, 13, 17, 19\}</m>
                  is a prime number less than 20.
                </p>
              </feedback>
            </test>
            <test>
              <jscmp>
                <!-- find why it fails to be in list -->
                function(){ const val=Number(ans); if (val &lt;= 0) { return "You need to give a positive integer." } if (val &gt;= 20) { return "The integer must be less than 20." } for (let i=2; i&lt;=3; i++) { if (val % i == 0) { return `Your answer is composite; for example, it is divisible by ${i}.` } } return false; }()
              </jscmp>
            </test>
          </evaluate>
        </evaluation>
      </exercise>
    </section>
  </article>
</pretext>
